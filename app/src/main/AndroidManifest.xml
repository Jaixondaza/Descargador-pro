<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 1. Permiso de Internet (Para descargar) -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- 2. Permisos para Android 12 y anteriores (Almacenamiento) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- 3. Permisos para Android 13+ (API 33 en adelante) -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- 4. Permisos opcionales para evitar que la descarga se corte en segundo plano -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Descargadorpro"
        
        <!-- IMPORTANTE: Estas dos líneas evitan errores de red y de almacenamiento -->
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        
        tools:targetApi="31">

        <!-- Pantalla Principal -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla del Editor (Asegúrate de que el nombre coincida con tu clase Kotlin) -->
        <activity
            android:name=".EditorActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

    </application>

</manifest>
